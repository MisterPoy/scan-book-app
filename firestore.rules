rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isProfileOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function allowedUserProfileFields() {
      return [
        "uid", "email", "displayName", "photoURL", "emailVerified",
        "createdAt", "lastLoginAt", "totalBooks", "totalLibraries",
        "lastActivity", "providerData"
      ];
    }

    // Private user data. Admin rights are never inferred from this writable tree.
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /user_profiles/{userId} {
      allow read: if isAdmin();
      allow create: if isProfileOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.keys().hasOnly(allowedUserProfileFields());
      allow update: if isProfileOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(allowedUserProfileFields());
      allow delete: if isProfileOwner(userId) || isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Append-only consent ledger. Its owner may remove it with their account.
    match /user_consents/{consentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Legacy delivery history: no new write is accepted, but owners may erase it.
    match /notification_history/{historyId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
