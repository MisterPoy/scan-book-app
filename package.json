{
  "name": "kodeks",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-icons && npm run clean && tsc -b && vite build",
    "build:analyze": "npm run generate-icons && npm run clean && tsc -b && vite build --mode analyze",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run src",
    "test:rules": "node scripts/run-rule-tests.js",
    "test:ci": "npm run test && npm run test:rules",
    "generate-icons": "node scripts/generate-icons.js",
    "clean": "node scripts/clean-dist.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vercel/analytics": "^1.6.1",
    "firebase": "^11.10.0",
    "focus-trap-react": "^11.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "phosphor-react": "^1.4.1",
    "piexifjs": "^1.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-zxing": "^2.1.0",
    "recharts": "^3.2.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^15.24.0",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^6.0.4",
    "sharp": "^0.34.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.3",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^4.1.10"
  }
}
